{
  "name": "bridge-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "data:interests": "tsx scripts/build-interests.ts",
    "data:posts": "tsx scripts/build-posts.ts",
    "data:pool": "tsx scripts/build-pool.ts",
    "data:ranks": "tsx scripts/build-ranks.ts",
    "data:images": "tsx scripts/build-images.ts",
    "data:links": "tsx scripts/build-links.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/newsreader": "5.2.8",
    "@fontsource-variable/instrument-sans": "5.2.8",
    "@google/genai": "2.30.0",
    "fastify": "5.12.7",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
